# =============================================================================
# PRODUCAO — esquema de DOIS ambientes, o caminho de docs/AMBIENTES.md
#
# Par de .env.homologacao.example: producao e homologacao na mesma maquina, com
# bancos central_viagens_prod / central_viagens_homolog.
#
# NAO confundir com .env.production.example (em ingles): aquele e o modelo de
# VPS unica usado por docs/DEPLOY_VPS.md e por scripts/deploy_setup.sh, com
# outros nomes de banco e outros caminhos de midia. Os dois existem, sao
# incompativeis entre si, e seguir o errado configura caminhos que os scripts de
# deploy nao esperam (QA-09).
# =============================================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=troque-por-uma-chave-forte-e-exclusiva
DEBUG=False
ALLOWED_HOSTS=viagens.seudominio.com
LOGIN_ENFORCED=true

# Banco de dados exclusivo da producao
DB_ENGINE=django.db.backends.postgresql
DB_NAME=central_viagens_prod
DB_USER=central_viagens_prod_user
DB_PASSWORD=troque-esta-senha
DB_HOST=127.0.0.1
DB_PORT=5432

# Arquivos exclusivos da producao
MEDIA_ROOT=/var/www/central-viagens/producao/media
STATIC_ROOT=/var/www/central-viagens/producao/staticfiles

# Localizacao
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# Rotas
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
ROUTE_CACHE_ENABLED=true
ROUTE_REQUEST_TIMEOUT_SECONDS=12

# Documentos
DOCUMENTOS_DEFAULT_PDF_ENGINE=auto
DOCUMENTOS_PERSIST_ARTEFATOS=true

# Cache compartilhado entre os workers (QA-02) — OBRIGATORIO em producao.
# Sem esta variavel o Django cai para LocMemCache, que e por processo: com os 3
# workers do gunicorn o rate limit de login (5 tentativas / 15 min) vira ate ~15
# antes de um worker bloquear sozinho, e zera a cada restart. O mesmo cache
# alimenta /metrics/. config/settings/prod.py recusa subir sem ela.
REDIS_URL=redis://127.0.0.1:6379/1
