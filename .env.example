# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
LOGIN_ENFORCED=false

# Cifragem de campos sensiveis (tokens OAuth do Drive, etc). OBRIGATORIA em
# qualquer ambiente. Gere a SUA — nao reaproveite chave de outra maquina, e
# nunca commite a sua:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotacionar sem perder o que ja foi cifrado, liste a nova primeiro e
# mantenha a antiga em seguida, separadas por virgula.
FIELD_ENCRYPTION_KEYS=gere-a-sua-com-o-comando-acima

# PostgreSQL obrigatorio em desenvolvimento
DB_ENGINE=django.db.backends.postgresql
DB_NAME=central_viagens_3
DB_USER=central_viagens_user
DB_PASSWORD=central_viagens_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Arquivos locais
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Localizacao
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# Rotas (mapa / OpenRouteService — opcional; sem chave a tela abre, só o botão Calcular rota avisa)
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
ROUTE_CACHE_ENABLED=true
ROUTE_REQUEST_TIMEOUT_SECONDS=12

# Documentos (DOCX / PDF) — ver docs/DOCUMENTOS_GERACAO_DOCX_PDF.md
DOCUMENTOS_DEFAULT_PDF_ENGINE=unoserver
# DOCUMENTOS_PDF_AUTO_FALLBACK=true
# DOCUMENTOS_LIBREOFFICE_BINARY=
# Conversor persistente recomendado para o caminho rápido:
DOCUMENTOS_UNOSERVER_URL=http://127.0.0.1:2003
# DOCUMENTOS_UNOSERVER_TIMEOUT_SECONDS=5
# DOCUMENTOS_ENGINE_PROBE_CACHE_SECONDS=60
# DOCUMENTOS_BINARY_CONVERSION_CACHE=true
# DOCUMENTOS_BINARY_CACHE_SECONDS=86400
# METRICS_TOKEN=gere-um-token-longo
# SSO_REMOTE_USER_ENABLED=false
# SSO_MFA_REQUIRED=true
# SSO_MFA_ASSERTION_HEADER=HTTP_X_AUTH_MFA
# DOCUMENTOS_SIMPLE_PDF_FALLBACK=
# DOCUMENTOS_ENABLE_LIBREOFFICE=
# DOCUMENTOS_TMP_DIR=
# DOCUMENTOS_PERSIST_ARTEFATOS=true
# DOCUMENTOS_OFICIO_PDF_VIA_DOCX=true

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Integração eProtocolo (Paraná) — barramento spi-servicos
# Sem credenciais, o sistema opera 100% em modo mock (nenhuma chamada real).
# Para ativar o modo real, defina EPROTOCOLO_AMBIENTE=treinamento|homologacao|producao
# Para homologacao real controlada, use EPROTOCOLO_AMBIENTE=real_controlado
# e preencha BASE_URL/TOKEN_URL/CLIENT_ID/CLIENT_SECRET/CONSUMER_ID.
# NUNCA versione credenciais reais — mantenha-as apenas no seu .env local.
#
# Diagnóstico (não chamam produção):
#   python manage.py eprotocolo_check
#   python manage.py eprotocolo_ping
#   python manage.py eprotocolo_homologar --oficio <ID> --dry-run
#   python manage.py eprotocolo_homologar --oficio <ID> --real            (treinamento)
# Detalhes em docs/eprotocolo_treinamento.md
# ---------------------------------------------------------------------------
EPROTOCOLO_AMBIENTE=mock
EPROTOCOLO_BASE_URL=
EPROTOCOLO_TOKEN_URL=
EPROTOCOLO_CLIENT_ID=
EPROTOCOLO_CLIENT_SECRET=
EPROTOCOLO_CONSUMER_ID=
EPROTOCOLO_TIMEOUT=30
EPROTOCOLO_VERIFY_SSL=True
EPROTOCOLO_REAL_READONLY=True
EPROTOCOLO_REAL_MUTATIONS_ENABLED=False

# Códigos institucionais (não sensíveis) usados pelos mappers/serviços.
EPROTOCOLO_COD_ORGAO_PADRAO=
EPROTOCOLO_NOME_ORGAO_PADRAO=
EPROTOCOLO_COD_LOCAL_ORIGEM_PADRAO=
EPROTOCOLO_COD_LOCAL_DESTINO_PADRAO=
EPROTOCOLO_COD_ASSUNTO_VIAGEM=
EPROTOCOLO_COD_ESPECIE_OFICIO=
EPROTOCOLO_COD_PALAVRA_CHAVE_VIAGEM=
EPROTOCOLO_COD_TIPO_TRAMITACAO_PADRAO=
EPROTOCOLO_CPF_USUARIO_SISTEMA=

# Integração Google Drive
# Sem credenciais, o sistema opera 100% em modo mock (nenhuma chamada real).
#
# A conexão é OAuth 2.0 POR USUÁRIO: cada login institucional autoriza a própria
# conta Google pela tela Meu perfil. NÃO use Service Account — o código lê o
# token de `DriveCredenciais`, gravado pelo fluxo OAuth, e ignora chave JSON.
# Para ativar:
#   1. No Google Cloud Console, ative a Google Drive API no projeto.
#   2. Credenciais → Criar → ID do cliente OAuth → Aplicativo da Web.
#   3. Em "URIs de redirecionamento autorizados", cole exatamente o valor de
#      GOOGLE_REDIRECT_URI abaixo (o caminho precisa bater, barra final inclusa).
#   4. Copie ID e secret para as variáveis abaixo e ponha GOOGLE_DRIVE_MODO=ativo.
#   5. Na tela de consentimento, libere os escopos drive.file e drive.readonly.
#      Enquanto a publicação estiver como "Testing", o refresh token caduca em 7
#      dias e a conta precisa ser reconectada; publique o app para evitar isso.
#   6. Reinicie o serviço, entre em Meu perfil > Conta Google e clique Conectar.
#   7. Escolha a pasta raiz em Meu perfil > Diretório de destino.
# Diagnóstico: python manage.py gdrive_check        (configuração + pasta raiz)
# Prova real:  python manage.py gdrive_check --e2e  (sobe, confere e apaga)
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_MODO=mock
# Credenciais OAuth 2.0 geradas no Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gerenciadorviagens.tech/integracoes/google-drive/oauth/callback/
GOOGLE_DRIVE_PASTA_RAIZ_ID=
# GOOGLE_DRIVE_UPLOAD_EM_MOCK=false
# Timeout (segundos) por chamada à API do Drive; evita que uma conexão travada
# (ex.: falha de TLS no meio do caminho) trave pra sempre a reorganização em massa.
# GOOGLE_DRIVE_HTTP_TIMEOUT_SECONDS=30
# Validade (segundos) do cache de pastas e da checagem da pasta raiz. Zero
# desliga o cache; valores altos fazem um worker demorar mais para perceber que
# uma pasta foi movida ou lixeirada pelo próprio Drive.
# GOOGLE_DRIVE_PASTA_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Celery — fila de geração documental e sincronização com o Drive. Redis,
# worker e beat são obrigatórios em produção: sem eles, novos downloads
# assíncronos falham rápido e exibem o erro no polling.
# Suba um Redis local com: docker run -p 6379:6379 redis:7-alpine
# Suba o worker com: celery -A config worker -l info
# Suba a manutenção periódica com: celery -A config beat -l info
#
# SÃO DOIS WORKERS. O Drive tem fila própria para não atrasar a geração
# documental (as tarefas dele geram PDF de verdade e passam pelo mesmo
# unoserver). Sem o segundo worker, as tarefas do Drive param na fila:
#   celery -A config worker -l info -Q celery   # geração documental
#   celery -A config worker -l info -Q drive    # Google Drive
# Para voltar a um worker só, defina CELERY_DRIVE_QUEUE=celery.
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_CONNECTION_TIMEOUT=0.2
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_TASK_DEFAULT_QUEUE=celery
# CELERY_DRIVE_QUEUE=drive

# Assinatura digital PDF (pyHanko / PKCS#12)
# SIGNATURE_BACKEND=disabled
# SIGNATURE_PKCS12_PATH=
# SIGNATURE_PKCS12_PASSWORD=
# SIGNATURE_REASON=Documento institucional
# SIGNATURE_LOCATION=
# SIGNATURE_VISIBLE=true
# SIGNATURE_FIELD_NAME=AssinaturaCentralViagens
# Testes locais opcionais (assinatura+verificacao+adulteracao):
# SIGNATURE_TEST_PKCS12_PATH=
# SIGNATURE_TEST_PKCS12_PASSWORD=

# Cache compartilhado (opcional em desenvolvimento, OBRIGATORIO em producao).
# Sem ele o Django usa LocMemCache, por processo — suficiente para um runserver.
# Ver QA-02 em docs/CATALOGO_DEFEITOS_2026-08.md.
# REDIS_URL=redis://127.0.0.1:6379/1
