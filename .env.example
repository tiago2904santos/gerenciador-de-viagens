# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
LOGIN_ENFORCED=false

# Cifragem de campos sensiveis (tokens OAuth do Drive, etc). OBRIGATORIA em
# qualquer ambiente. Gere a SUA — nao reaproveite chave de outra maquina, e
# nunca commite a sua:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotacionar sem perder o que ja foi cifrado, liste a nova primeiro e
# mantenha a antiga em seguida, separadas por virgula.
FIELD_ENCRYPTION_KEYS=gere-a-sua-com-o-comando-acima

# PostgreSQL obrigatorio em desenvolvimento
DB_ENGINE=django.db.backends.postgresql
DB_NAME=central_viagens_3
DB_USER=central_viagens_user
DB_PASSWORD=central_viagens_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Arquivos locais
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Localizacao
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# Rotas (mapa / OpenRouteService — opcional; sem chave a tela abre, só o botão Calcular rota avisa)
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
ROUTE_CACHE_ENABLED=true
ROUTE_REQUEST_TIMEOUT_SECONDS=12

# Documentos (DOCX / PDF) — ver docs/DOCUMENTOS_GERACAO_DOCX_PDF.md
DOCUMENTOS_DEFAULT_PDF_ENGINE=unoserver
# DOCUMENTOS_PDF_AUTO_FALLBACK=true
# DOCUMENTOS_LIBREOFFICE_BINARY=
# Conversor persistente recomendado para o caminho rápido:
DOCUMENTOS_UNOSERVER_URL=http://127.0.0.1:2003
# DOCUMENTOS_UNOSERVER_TIMEOUT_SECONDS=5
# DOCUMENTOS_ENGINE_PROBE_CACHE_SECONDS=60
# DOCUMENTOS_BINARY_CONVERSION_CACHE=true
# DOCUMENTOS_BINARY_CACHE_SECONDS=86400
# METRICS_TOKEN=gere-um-token-longo
# SSO_REMOTE_USER_ENABLED=false
# SSO_MFA_REQUIRED=true
# SSO_MFA_ASSERTION_HEADER=HTTP_X_AUTH_MFA
# DOCUMENTOS_SIMPLE_PDF_FALLBACK=
# DOCUMENTOS_ENABLE_LIBREOFFICE=
# DOCUMENTOS_TMP_DIR=
# DOCUMENTOS_PERSIST_ARTEFATOS=true
# DOCUMENTOS_OFICIO_PDF_VIA_DOCX=true

# ---------------------------------------------------------------------------
# Integração Google Drive
# Sem credenciais, o sistema opera 100% em modo mock (nenhuma chamada real).
# Para ativar:
#   1. Crie um Service Account no Google Cloud → baixe a chave JSON.
#   2. Ative a Google Drive API no projeto.
#   3. Compartilhe a pasta raiz do Drive com o email do service account (Editor).
#   4. Copie o ID da pasta da URL (trecho após /folders/).
# Diagnóstico: python manage.py gdrive_check
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_MODO=mock
# Credenciais OAuth 2.0 geradas no Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gerenciadorviagens.tech/integracoes/google-drive/oauth/callback/
GOOGLE_DRIVE_PASTA_RAIZ_ID=
# GOOGLE_DRIVE_UPLOAD_EM_MOCK=false
# Timeout (segundos) por chamada à API do Drive; evita que uma conexão travada
# (ex.: falha de TLS no meio do caminho) trave pra sempre a reorganização em massa.
# GOOGLE_DRIVE_HTTP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Celery — fila de sincronização em segundo plano. Sem worker/Redis no ar, o
# documento continua salvo localmente e o envio ao Drive fica registrado como
# pendente; nenhuma chamada à API do Google acontece dentro da requisição.
# Suba um Redis local com: docker run -p 6379:6379 redis:7-alpine
# Suba o worker com: celery -A config worker -l info
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_CONNECTION_TIMEOUT=0.2
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false

# Assinatura digital PDF (pyHanko / PKCS#12)
# SIGNATURE_BACKEND=disabled
# SIGNATURE_PKCS12_PATH=
# SIGNATURE_PKCS12_PASSWORD=
# SIGNATURE_REASON=Documento institucional
# SIGNATURE_LOCATION=
# SIGNATURE_VISIBLE=true
# SIGNATURE_FIELD_NAME=AssinaturaCentralViagens
# Testes locais opcionais (assinatura+verificacao+adulteracao):
# SIGNATURE_TEST_PKCS12_PATH=
# SIGNATURE_TEST_PKCS12_PASSWORD=
