# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
LOGIN_ENFORCED=false

# PostgreSQL obrigatorio em desenvolvimento
DB_ENGINE=django.db.backends.postgresql
DB_NAME=central_viagens_3
DB_USER=central_viagens_user
DB_PASSWORD=central_viagens_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# Arquivos locais
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Localizacao
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# Rotas (mapa / OpenRouteService — opcional; sem chave a tela abre, só o botão Calcular rota avisa)
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
ROUTE_CACHE_ENABLED=true
ROUTE_REQUEST_TIMEOUT_SECONDS=12

# Documentos (DOCX / PDF) — ver docs/DOCUMENTOS_GERACAO_DOCX_PDF.md
DOCUMENTOS_DEFAULT_PDF_ENGINE=auto
# DOCUMENTOS_PDF_AUTO_FALLBACK=true
# DOCUMENTOS_LIBREOFFICE_BINARY=
# DOCUMENTOS_UNOSERVER_URL=
# DOCUMENTOS_SIMPLE_PDF_FALLBACK=
# DOCUMENTOS_ENABLE_LIBREOFFICE=
# DOCUMENTOS_TMP_DIR=
# DOCUMENTOS_PERSIST_ARTEFATOS=true
# DOCUMENTOS_OFICIO_PDF_VIA_DOCX=true

# ---------------------------------------------------------------------------
# Integração eProtocolo (Paraná)
# Sem credenciais, o sistema opera 100% em modo mock (nenhuma chamada real).
# Para ativar o modo real, defina EPROTOCOLO_AMBIENTE=homologacao|producao e
# preencha BASE_URL/TOKEN_URL/CLIENT_ID/CLIENT_SECRET/CONSUMER_ID.
# NUNCA versione credenciais reais — mantenha-as apenas no seu .env local.
# ---------------------------------------------------------------------------
EPROTOCOLO_AMBIENTE=mock
EPROTOCOLO_BASE_URL=
EPROTOCOLO_TOKEN_URL=
EPROTOCOLO_CLIENT_ID=
EPROTOCOLO_CLIENT_SECRET=
EPROTOCOLO_CONSUMER_ID=
EPROTOCOLO_TIMEOUT=30
EPROTOCOLO_VERIFY_SSL=True

# Códigos institucionais (não sensíveis) usados pelos mappers/serviços.
EPROTOCOLO_COD_ORGAO_PADRAO=
EPROTOCOLO_NOME_ORGAO_PADRAO=
EPROTOCOLO_COD_LOCAL_ORIGEM_PADRAO=
EPROTOCOLO_COD_LOCAL_DESTINO_PADRAO=
EPROTOCOLO_COD_ASSUNTO_VIAGEM=
EPROTOCOLO_COD_ESPECIE_OFICIO=
EPROTOCOLO_COD_PALAVRA_CHAVE_VIAGEM=
EPROTOCOLO_COD_TIPO_TRAMITACAO_PADRAO=
EPROTOCOLO_CPF_USUARIO_SISTEMA=

# Assinatura digital PDF (pyHanko / PKCS#12)
# SIGNATURE_BACKEND=disabled
# SIGNATURE_PKCS12_PATH=
# SIGNATURE_PKCS12_PASSWORD=
# SIGNATURE_REASON=Documento institucional
# SIGNATURE_LOCATION=
# SIGNATURE_VISIBLE=true
# SIGNATURE_FIELD_NAME=AssinaturaCentralViagens
# Testes locais opcionais (assinatura+verificacao+adulteracao):
# SIGNATURE_TEST_PKCS12_PATH=
# SIGNATURE_TEST_PKCS12_PASSWORD=
