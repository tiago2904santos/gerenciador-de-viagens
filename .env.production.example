# =============================================================================
# PRODUCAO — VPS unica, o caminho de docs/DEPLOY_VPS.md
#
# Este e o modelo usado por docs/DEPLOY_VPS.md e por scripts/deploy_setup.sh.
# Copie para .env e preencha antes de subir o servidor.
#
# NAO confundir com .env.producao.example (em portugues): aquele pertence ao
# esquema de DOIS ambientes na mesma maquina (producao + homologacao) descrito
# em docs/AMBIENTES.md, e usa outros nomes de banco e outros caminhos de midia.
# Os dois existem, sao incompativeis entre si, e seguir o errado configura
# caminhos que os scripts de deploy nao esperam (QA-09).
# =============================================================================

# Django
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=false
# Coloque o IP do VPS e/ou o dominio (sem https://)
ALLOWED_HOSTS=
# Domínio(s) com https:// — necessário para POST (anexar termo, formulários)
# CSRF_TRUSTED_ORIGINS=https://seu-dominio.gov.br
LOGIN_ENFORCED=true
DJANGO_SETTINGS_MODULE=config.settings.prod

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=viagens_prod
DB_USER=viagens_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Arquivos
MEDIA_ROOT=/var/www/gerenciador-viagens/media
STATIC_ROOT=/var/www/gerenciador-viagens/staticfiles

# Localizacao
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# Rotas (OpenRouteService — opcional, peca sua chave gratis em openrouteservice.org)
ROUTE_PROVIDER=openrouteservice
OPENROUTESERVICE_API_KEY=
ROUTE_CACHE_ENABLED=true
ROUTE_REQUEST_TIMEOUT_SECONDS=12

# Documentos PDF (WeasyPrint e fallbacks)
DOCUMENTOS_DEFAULT_PDF_ENGINE=auto
DOCUMENTOS_PDF_AUTO_FALLBACK=true
DOCUMENTOS_PERSIST_ARTEFATOS=true
DOCUMENTOS_PREGENERATE_PDF=false
DOCUMENTOS_TMP_DIR=/var/www/gerenciador-viagens/media/tmp_documentos
# DOCUMENTOS_ENABLE_LIBREOFFICE=false   # Deixe false; WeasyPrint e suficiente para producao

# Assinatura digital (opcional — mantenha comentado se nao usar)
# SIGNATURE_BACKEND=disabled
# SIGNATURE_PKCS12_PATH=
# SIGNATURE_PKCS12_PASSWORD=

# Celery — retry automatico de uploads ao Drive em segundo plano.
# Exige Redis instalado no VPS (apt install redis-server) e o servico
# systemd do worker (ver docs/DEPLOY_VPS.md, secao 5.3).
CELERY_BROKER_URL=redis://localhost:6379/0

# Cache compartilhado entre os workers (QA-02) — OBRIGATORIO em producao.
# Sem esta variavel o Django cai para LocMemCache, que e por processo: com os 3
# workers do gunicorn o rate limit de login (5 tentativas / 15 min) vira ate ~15
# antes de um worker bloquear sozinho, e zera a cada restart. O mesmo cache
# alimenta /metrics/. config/settings/prod.py recusa subir sem ela.
REDIS_URL=redis://127.0.0.1:6379/1
